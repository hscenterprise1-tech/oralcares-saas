APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# How the two portals are addressed. "path" serves Company at /company and
# Clinic at /clinic; "domain" (the default when this is unset) serves Company at
# admin.<APP_URL host> and each tenant at <clinic>.<APP_URL host>. Setting this
# wrong changes every URL in the application, so it is named here rather than
# left to the default.
ROUTING_MODE=path

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MASTER_ADMIN_NAME=
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=

# Local only: lets the demo data seeders (CompanyPeopleFinanceSeeder) run.
# They refuse to run outside local/testing regardless. Never true on a server.
SEED_DEMO_DATA=false

# Meta signs every WhatsApp webhook with this. Until it is set, the public
# webhook endpoint accepts payloads without proving they came from Meta.
META_WHATSAPP_APP_SECRET=

# ---- Security infrastructure (docs/security/production-deployment.md) ----
# Malware scanning: "clamav" in staging/production; "fake" only for local/tests.
MALWARE_SCANNER=fake
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Patient documents: s3 in production (public access blocked, SSE, versioning).
PRIVATE_FILESYSTEM_DRIVER=local
PRIVATE_AWS_BUCKET=

# Encrypted database backups: key in the secret manager, bucket in a separate account.
BACKUP_ENCRYPTION_KEY=
BACKUP_FILESYSTEM_DRIVER=local
BACKUP_AWS_BUCKET=
BACKUP_VERIFY_CONNECTION=

# Security trail: syslog or stderr in production, shipped to an external store.
SECURITY_LOG_DRIVER=daily
SECURITY_AUDIT_CHAIN_KEY=
SECURITY_AUDIT_RETENTION_DAYS=180
